rules_version = '2';

// Firestore security rules for the Boston Ni Baaje app.
//
// HOW TO APPLY: Firebase console → Build → Firestore Database → Rules tab →
// paste this whole file → Publish.
//
// Who someone is comes from members/{uid} (uid = their phone number, e.g.
// "+16175551234"). Only the Cloudflare Worker writes members/, secrets/,
// joinCodes/ and rateLimits/ — it uses the service account, which skips these
// rules — so clients can never make themselves a director.
//
// Chats (keep in sync with chatsFor()/canPost() in worker/src/worker.js):
//   announcements — everyone reads; board + directors post
//   board         — board + directors
//   team-{teamId} — that team's dancers + liaisons, plus directors

service cloud.firestore {
  match /databases/{database}/documents {

    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }
    function isMember() {
      return request.auth != null && exists(memberPath());
    }
    function me() {
      return get(memberPath()).data;
    }
    function isDirector() {
      return isMember() && me().role == 'director';
    }
    function isStaff() {
      return isMember() && me().role in ['director', 'board'];
    }

    function canRead(chatId) {
      return isMember() && (
        chatId == 'announcements' ||
        (chatId == 'board' && me().role in ['director', 'board']) ||
        (chatId.matches('team-[a-z0-9]+') &&
          (me().role == 'director' || chatId == 'team-' + me().get('teamId', '')))
      );
    }
    function canPost(chatId) {
      return chatId == 'announcements' ? isStaff() : canRead(chatId);
    }

    // Member directory — any member can read it (to show names). Worker-only writes.
    match /members/{uid} {
      allow read: if isMember();
      allow write: if false;
    }

    // Chat list metadata (last message preview) + messages.
    match /chats/{chatId} {
      allow read: if canRead(chatId);
      allow create, update: if canPost(chatId) &&
        request.resource.data.keys().hasOnly(['lastMessage', 'lastFrom', 'updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canRead(chatId);
        allow create: if canPost(chatId) &&
          request.resource.data.keys().hasOnly(['text', 'uid', 'name', 'createdAt']) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000;
        // History is immutable — no edits or deletes.
        allow update, delete: if false;
      }
    }

    // Announcements: the public Updates feed AND the in-app announcements chat.
    // Anyone can read; board + directors post; directors can fix/remove.
    // (Push delivery is handled by the Cloudflare Worker via FCM topics.)
    match /announcements/{id} {
      allow read: if true;
      allow create: if isStaff();
      allow update, delete: if isDirector();
    }

    // secrets/, joinCodes/, rateLimits/ and the retired threads/ have no rules
    // here, so clients are denied by default.
  }
}
